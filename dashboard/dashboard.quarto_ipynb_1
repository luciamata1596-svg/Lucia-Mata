      "source": [
        "plot_data = pd.read_csv(\"../Project/Output/forecast_results.csv\")\n",
        "\n",
        "plot_data[\"Target_Date\"] = pd.PeriodIndex(\n",
        "    plot_data[\"Target\"].astype(str), freq=\"Q\"\n",
        ").to_timestamp()\n",
        "\n",
        "fig, axes = plt.subplots(2, 1, figsize=(12, 7), sharex=True, sharey=True)\n",
        "\n",
        "forecast_series = [\n",
        "    (\"ARIMA_Forecast\", \"ARIMA(0,0,1)\", \"#B87333\", \"-\"),\n",
        "    (\"Mean_Forecast\", \"Historical Mean\", \"#008080\", \"--\"),\n",
        "    (\"AR1_Forecast\", \"AR(1)\", \"royalblue\", \"-.\"),\n",
        "    (\"RW_Forecast\", \"Random Walk\", \"gray\", \":\"),\n",
        "]\n",
        "\n",
        "for ax, horizon in zip(axes, [1, 4]):\n",
        "    data_h = plot_data.loc[plot_data[\"Horizon\"] == horizon].sort_values(\"Target_Date\")\n",
        "\n",
        "    ax.plot(data_h[\"Target_Date\"], data_h[\"Actual\"],\n",
        "            color=\"black\", linewidth=2, label=\"Actual\")\n",
        "\n",
        "    for column, label, color, style in forecast_series:\n",
        "        ax.plot(data_h[\"Target_Date\"], data_h[column],\n",
        "                color=color, linestyle=style, linewidth=1.4, label=label)\n",
        "\n",
        "    ax.axvspan(\n",
        "        pd.Period(\"2020Q2\", freq=\"Q\").start_time,\n",
        "        pd.Period(\"2021Q1\", freq=\"Q\").end_time,\n",
        "        color=\"lightgray\", alpha=0.35, label=\"COVID-19 target quarters\"\n",
        "    )\n",
        "    ax.axhline(0, color=\"black\", linewidth=0.6)\n",
        "    ax.set_title(f\"Forecast Horizon: {horizon} quarter(s)\")\n",
        "    ax.set_ylabel(\"GDP Growth (%)\")\n",
        "    ax.legend(fontsize=8, ncol=3, loc=\"lower right\")\n",
        "\n",
        "axes[1].set_xlabel(\"Target Quarter\")\n",
        "fig.tight_layout()\n",
        "plt.show()"
      ],
