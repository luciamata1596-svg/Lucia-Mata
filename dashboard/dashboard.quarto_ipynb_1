    {
      "cell_type": "code",
      "metadata": {
        "title": "Stationarity (ADF Test)"
      },
      "source": [
        "from statsmodels.tsa.stattools import adfuller\n",
        "from tabulate import tabulate\n",
        "from IPython.display import Markdown\n",
        "\n",
        "tests = [\n",
        "    (\"Log Real GDP\", df[\"Log_Real_GDP\"].dropna(), \"ct\"),\n",
        "    (\"GDP Growth (%)\", df[\"GDP_Growth\"].dropna(), \"c\"),\n",
        "]\n",
        "\n",
        "rows = []\n",
        "for name, series, regression in tests:\n",
        "    result = adfuller(series, regression=regression, autolag=\"AIC\")\n",
        "    conclusion = (\n",
        "        \"Stationary\"\n",
        "        if result[1] < 0.05\n",
        "        else \"Do not reject unit root\"\n",
        "    )\n",
        "    rows.append([\n",
        "        name,\n",
        "        f\"{result[0]:.3f}\",\n",
        "        f\"{result[1]:.4f}\",\n",
        "        result[2],\n",
        "        conclusion,\n",
        "    ])\n",
        "\n",
        "adf_table = pd.DataFrame(\n",
        "    rows,\n",
        "    columns=[\"Series\", \"ADF statistic\", \"p-value\", \"Lags\", \"Conclusion\"]\n",
        ")\n",
        "Markdown(tabulate(adf_table, showindex=False, headers=adf_table.columns))"
      ],
      "id": "819b0ccc",
      "execution_count": null,
      "outputs": []
    },
