      "source": [
        "import pandas as pd\n",
        "\n",
        "# Data lives in its own data/ subfolder, separate from code -- a habit\n",
        "# worth keeping as this repo grows. Use forward slashes in the path,\n",
        "# even on Windows: Python/pandas accept them on every OS, so the same\n",
        "# code runs unchanged whether you're on Windows, Mac, or Linux. A\n",
        "# single backslash (data\\file.csv) is NOT safe here -- Python reads\n",
        "# backslashes as escape characters inside a string, which can silently\n",
        "# produce the wrong path.\n",
        "df = pd.read_csv(\"../Project/data/data/Clean Data/mexico_gdp_clean.csv\")\n",
        "n_growth = df[\"GDP_Growth\"].dropna().shape[0]\n",
