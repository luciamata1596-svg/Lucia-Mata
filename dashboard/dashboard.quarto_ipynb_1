        "title": "Mexico Real GDP and Quarterly Growth"
      },
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "EO_COPPER = \"#B87333\"\n",
        "EO_SAGE = \"#8A9A5B\"\n",
        "EO_TERRACOTTA = \"#E2725B\"\n",
        "EO_CHARCOAL = \"#36454F\"\n",
        "\n",
        "df[\"QuarterDate\"] = pd.PeriodIndex(df[\"Quarter\"], freq=\"Q\").to_timestamp()\n",
        "\n",
        "fig, axes = plt.subplots(2, 1, figsize=(11, 6), sharex=True)\n",
        "\n",
        "axes[0].plot(df[\"QuarterDate\"], df[\"Real_GDP\"], color=\"#4472C4\")\n",
        "axes[0].set_title(\"Real GDP\")\n",
        "axes[0].set_ylabel(\"Millions of 2018 pesos\")\n",
        "\n",
        "axes[1].plot(df[\"QuarterDate\"], df[\"GDP_Growth\"], color=\"#E2725B\")\n",
        "axes[1].axhline(0, color=\"gray\", linewidth=0.8)\n",
        "axes[1].set_title(\"Quarterly GDP Growth\")\n",
        "axes[1].set_ylabel(\"Percent\")\n",
        "axes[1].set_xlabel(\"Quarter\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "01dd23fd",
      "execution_count": null,
      "outputs": []
